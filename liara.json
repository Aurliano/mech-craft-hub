{
  "app": "mech-craft-hub-main",
  "platform": "docker",
  "port": 80,
  "build": {
    "location": "iran",
    "dockerfile": "Dockerfile.liara"
  },
  "disks": [
    {
      "name": "sayda-disk",
      "mountTo": "/app/backend/media"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "config.settings_ultra_simple",
    "PYTHONPATH": "/app/backend"
  },
  "nginx": {
    "config": "liara_nginx.conf"
  },
  "healthCheck": {
    "command": "CMD curl --fail http://localhost:80/api/health/ || exit 1",
    "interval": 30000,
    "timeout": 10000,
    "retries": 3,
    "startPeriod": 3000
  }
}
