{
  "app": "mech-craft-hub-main",
  "platform": "python",
  "port": 80,
  "build": {
    "location": "iran",
    "commands": [
      "cd backend && python manage.py collectstatic --noinput",
      "cd backend && python manage.py migrate --run-syncdb"
    ]
  },
  "deploy": {
    "startCommand": "cd backend && gunicorn config.wsgi:application --bind 0.0.0.0:80 --workers 3 --timeout 120"
  },
  "disks": [],
  "env": {
    "DEBUG": "False",
    "DJANGO_SETTINGS_MODULE": "config.settings_simple",
    "PYTHONPATH": "/app/backend"
  }
}
