# SMS.ir Configuration
SMS_KEY=your_api_key_here  # API Key from SMS.ir panel
SMS_SENDER=1000XXX         # Your dedicated line number from SMS.ir
SMS_TEMPLATE_ID_VERIFICATION=100000  # Template ID for verification messages
SMS_TEMPLATE_ID_PASSWORD_RESET=100001  # Template ID for password reset messages

# Advanced SMS Configuration (Optional)
SMS_API_TIMEOUT=30  # API request timeout in seconds
SMS_API_BASE_URL=https://api.sms.ir/v1  # SMS.ir API base URL