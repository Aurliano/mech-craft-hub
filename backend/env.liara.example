# Liara Object Storage Configuration
# این فایل را به .env تغییر نام دهید و مقادیر را با اطلاعات خود پر کنید

# Liara S3 Credentials
# از پنل Liara بخش Object Storage این اطلاعات را دریافت کنید
LIARA_ACCESS_KEY_ID=your-liara-access-key-id
LIARA_SECRET_ACCESS_KEY=your-liara-secret-access-key

# S3 Configuration
S3_ENDPOINT_URL=https://storage.c2.liara.space
FILE_BUCKET_NAME=resources
FILE_REGION=iran
FILE_PUBLIC_ACCESS=True

# User Files Configuration
USER_FILES_STORAGE=local
USER_FILES_MAX_SIZE=104857600  # 100MB
ALLOWED_FILE_TYPES=pdf,image,document,cad,stl,stp,step,iges,dwg,dxf
MAX_FILE_SIZE=52428800  # 50MB

# Storage Type
FILE_STORAGE_TYPE=liara
FILE_FALLBACK_TO_LOCAL=False
