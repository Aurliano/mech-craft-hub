{
  "expo": {
    "name": "سایدا",
    "slug": "sayda-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1e3a5f"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ir.saydatech.saida",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "برای انتخاب تصاویر نیاز به دسترسی به گالری داریم",
        "NSCameraUsageDescription": "برای گرفتن عکس نیاز به دسترسی به دوربین داریم"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1e3a5f"
      },
      "package": "ir.saydatech.saida",
      "versionCode": 1,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {},
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#1e3a5f"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "برای انتخاب تصاویر نیاز به دسترسی به گالری داریم",
          "cameraPermission": "برای گرفتن عکس نیاز به دسترسی به دوربین داریم"
        }
      ],
      "expo-secure-store"
    ],
    "scheme": "saida",
    "extra": {
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}
