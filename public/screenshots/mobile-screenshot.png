
    <svg width="375" height="667" viewBox="0 0 375 667" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="bg-screenshot" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" style="stop-color:#f8f9fa;stop-opacity:1" />
          <stop offset="100%" style="stop-color:#e9ecef;stop-opacity:1" />
        </linearGradient>
        <linearGradient id="header-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" style="stop-color:#007bff;stop-opacity:1" />
          <stop offset="100%" style="stop-color:#0056b3;stop-opacity:1" />
        </linearGradient>
      </defs>
      
      <!-- Background -->
      <rect width="375" height="667" fill="url(#bg-screenshot)" rx="8"/>
      
      <!-- Header -->
      <rect x="0" y="0" width="375" height="100.05" fill="url(#header-gradient)" rx="8"/>
      
      <!-- Logo in header -->
      <circle cx="30" cy="50.025" r="12" fill="#ffffff" opacity="0.9"/>
      <circle cx="30" cy="50.025" r="8" fill="#007bff"/>
      
      <!-- Title -->
      <text x="50" y="54.025" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="#ffffff">
        پلتفرم مهندسی سایدا
      </text>
      
      <!-- Content area -->
      <rect x="10" y="110.05" width="355" height="546.95" fill="#ffffff" rx="4" opacity="0.9"/>
      
      <!-- Content elements -->
      
        <!-- Mobile content -->
        <rect x="157.5" y="130.05" width="60" height="40" fill="#007bff" opacity="0.1" rx="4"/>
        <text x="187.5" y="155.05" font-family="Arial, sans-serif" font-size="10" text-anchor="middle" fill="#007bff">خدمات</text>
        
        <rect x="157.5" y="180.05" width="60" height="40" fill="#28a745" opacity="0.1" rx="4"/>
        <text x="187.5" y="205.05" font-family="Arial, sans-serif" font-size="10" text-anchor="middle" fill="#28a745">مقالات</text>
        
        <rect x="157.5" y="230.05" width="60" height="40" fill="#dc3545" opacity="0.1" rx="4"/>
        <text x="187.5" y="255.05" font-family="Arial, sans-serif" font-size="10" text-anchor="middle" fill="#dc3545">تماس</text>
      
      
      <!-- Footer -->
      <rect x="10" y="637" width="355" height="20" fill="#6c757d" opacity="0.1" rx="4"/>
      <text x="187.5" y="652" font-family="Arial, sans-serif" font-size="8" text-anchor="middle" fill="#6c757d">saydatech.ir</text>
    </svg>
  