
<svg width="512" height="512" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#007bff;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0056b3;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background Circle -->
  <circle cx="256" cy="256" r="252" fill="url(#bg)" stroke="#ffffff" stroke-width="2"/>
  
  <!-- Gear Icon -->
  <g transform="translate(256, 256)">
    <!-- Main gear body -->
    <circle cx="0" cy="0" r="76.8" fill="#ffffff" opacity="0.9"/>
    
    <!-- Gear teeth -->
    <g fill="#ffffff" opacity="0.8">
      <!-- Top teeth -->
      <rect x="-10.24" y="-128" width="20.48" height="40.96" rx="5.12"/>
      <rect x="-10.24" y="87.04" width="20.48" height="40.96" rx="5.12"/>
      
      <!-- Side teeth -->
      <rect x="-128" y="-10.24" width="40.96" height="20.48" rx="5.12"/>
      <rect x="87.04" y="-10.24" width="40.96" height="20.48" rx="5.12"/>
      
      <!-- Diagonal teeth -->
      <rect x="-92.16" y="-92.16" width="30.72" height="15.36" rx="5.12" transform="rotate(-45)"/>
      <rect x="61.44" y="61.44" width="30.72" height="15.36" rx="5.12" transform="rotate(-45)"/>
      <rect x="92.16" y="-92.16" width="30.72" height="15.36" rx="5.12" transform="rotate(45)"/>
      <rect x="-61.44" y="61.44" width="30.72" height="15.36" rx="5.12" transform="rotate(45)"/>
    </g>
    
    <!-- Center hole -->
    <circle cx="0" cy="0" r="30.72" fill="#007bff"/>
  </g>
  
  <!-- Text -->
  <text x="256" y="435.2" font-family="Arial, sans-serif" font-size="61.44" font-weight="bold" text-anchor="middle" fill="#ffffff">سایدا</text>
</svg>
