
<svg width="72" height="72" viewBox="0 0 72 72" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#007bff;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0056b3;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background Circle -->
  <circle cx="36" cy="36" r="32" fill="url(#bg)" stroke="#ffffff" stroke-width="2"/>
  
  <!-- Gear Icon -->
  <g transform="translate(36, 36)">
    <!-- Main gear body -->
    <circle cx="0" cy="0" r="10.799999999999999" fill="#ffffff" opacity="0.9"/>
    
    <!-- Gear teeth -->
    <g fill="#ffffff" opacity="0.8">
      <!-- Top teeth -->
      <rect x="-1.44" y="-18" width="2.88" height="5.76" rx="0.72"/>
      <rect x="-1.44" y="12.24" width="2.88" height="5.76" rx="0.72"/>
      
      <!-- Side teeth -->
      <rect x="-18" y="-1.44" width="5.76" height="2.88" rx="0.72"/>
      <rect x="12.24" y="-1.44" width="5.76" height="2.88" rx="0.72"/>
      
      <!-- Diagonal teeth -->
      <rect x="-12.959999999999999" y="-12.959999999999999" width="4.32" height="2.16" rx="0.72" transform="rotate(-45)"/>
      <rect x="8.64" y="8.64" width="4.32" height="2.16" rx="0.72" transform="rotate(-45)"/>
      <rect x="12.959999999999999" y="-12.959999999999999" width="4.32" height="2.16" rx="0.72" transform="rotate(45)"/>
      <rect x="-8.64" y="8.64" width="4.32" height="2.16" rx="0.72" transform="rotate(45)"/>
    </g>
    
    <!-- Center hole -->
    <circle cx="0" cy="0" r="4.32" fill="#007bff"/>
  </g>
  
  <!-- Text -->
  <text x="36" y="61.199999999999996" font-family="Arial, sans-serif" font-size="8.64" font-weight="bold" text-anchor="middle" fill="#ffffff">سایدا</text>
</svg>
