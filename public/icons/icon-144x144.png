
<svg width="144" height="144" viewBox="0 0 144 144" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#007bff;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0056b3;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background Circle -->
  <circle cx="72" cy="72" r="68" fill="url(#bg)" stroke="#ffffff" stroke-width="2"/>
  
  <!-- Gear Icon -->
  <g transform="translate(72, 72)">
    <!-- Main gear body -->
    <circle cx="0" cy="0" r="21.599999999999998" fill="#ffffff" opacity="0.9"/>
    
    <!-- Gear teeth -->
    <g fill="#ffffff" opacity="0.8">
      <!-- Top teeth -->
      <rect x="-2.88" y="-36" width="5.76" height="11.52" rx="1.44"/>
      <rect x="-2.88" y="24.48" width="5.76" height="11.52" rx="1.44"/>
      
      <!-- Side teeth -->
      <rect x="-36" y="-2.88" width="11.52" height="5.76" rx="1.44"/>
      <rect x="24.48" y="-2.88" width="11.52" height="5.76" rx="1.44"/>
      
      <!-- Diagonal teeth -->
      <rect x="-25.919999999999998" y="-25.919999999999998" width="8.64" height="4.32" rx="1.44" transform="rotate(-45)"/>
      <rect x="17.28" y="17.28" width="8.64" height="4.32" rx="1.44" transform="rotate(-45)"/>
      <rect x="25.919999999999998" y="-25.919999999999998" width="8.64" height="4.32" rx="1.44" transform="rotate(45)"/>
      <rect x="-17.28" y="17.28" width="8.64" height="4.32" rx="1.44" transform="rotate(45)"/>
    </g>
    
    <!-- Center hole -->
    <circle cx="0" cy="0" r="8.64" fill="#007bff"/>
  </g>
  
  <!-- Text -->
  <text x="72" y="122.39999999999999" font-family="Arial, sans-serif" font-size="17.28" font-weight="bold" text-anchor="middle" fill="#ffffff">سایدا</text>
</svg>
