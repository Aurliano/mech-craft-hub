
<svg width="96" height="96" viewBox="0 0 96 96" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#007bff;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0056b3;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background Circle -->
  <circle cx="48" cy="48" r="44" fill="url(#bg)" stroke="#ffffff" stroke-width="2"/>
  
  <!-- Gear Icon -->
  <g transform="translate(48, 48)">
    <!-- Main gear body -->
    <circle cx="0" cy="0" r="14.399999999999999" fill="#ffffff" opacity="0.9"/>
    
    <!-- Gear teeth -->
    <g fill="#ffffff" opacity="0.8">
      <!-- Top teeth -->
      <rect x="-1.92" y="-24" width="3.84" height="7.68" rx="0.96"/>
      <rect x="-1.92" y="16.32" width="3.84" height="7.68" rx="0.96"/>
      
      <!-- Side teeth -->
      <rect x="-24" y="-1.92" width="7.68" height="3.84" rx="0.96"/>
      <rect x="16.32" y="-1.92" width="7.68" height="3.84" rx="0.96"/>
      
      <!-- Diagonal teeth -->
      <rect x="-17.28" y="-17.28" width="5.76" height="2.88" rx="0.96" transform="rotate(-45)"/>
      <rect x="11.52" y="11.52" width="5.76" height="2.88" rx="0.96" transform="rotate(-45)"/>
      <rect x="17.28" y="-17.28" width="5.76" height="2.88" rx="0.96" transform="rotate(45)"/>
      <rect x="-11.52" y="11.52" width="5.76" height="2.88" rx="0.96" transform="rotate(45)"/>
    </g>
    
    <!-- Center hole -->
    <circle cx="0" cy="0" r="5.76" fill="#007bff"/>
  </g>
  
  <!-- Text -->
  <text x="48" y="81.6" font-family="Arial, sans-serif" font-size="11.52" font-weight="bold" text-anchor="middle" fill="#ffffff">سایدا</text>
</svg>
