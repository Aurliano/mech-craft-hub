
<svg width="192" height="192" viewBox="0 0 192 192" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#007bff;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0056b3;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background Circle -->
  <circle cx="96" cy="96" r="92" fill="url(#bg)" stroke="#ffffff" stroke-width="2"/>
  
  <!-- Gear Icon -->
  <g transform="translate(96, 96)">
    <!-- Main gear body -->
    <circle cx="0" cy="0" r="28.799999999999997" fill="#ffffff" opacity="0.9"/>
    
    <!-- Gear teeth -->
    <g fill="#ffffff" opacity="0.8">
      <!-- Top teeth -->
      <rect x="-3.84" y="-48" width="7.68" height="15.36" rx="1.92"/>
      <rect x="-3.84" y="32.64" width="7.68" height="15.36" rx="1.92"/>
      
      <!-- Side teeth -->
      <rect x="-48" y="-3.84" width="15.36" height="7.68" rx="1.92"/>
      <rect x="32.64" y="-3.84" width="15.36" height="7.68" rx="1.92"/>
      
      <!-- Diagonal teeth -->
      <rect x="-34.56" y="-34.56" width="11.52" height="5.76" rx="1.92" transform="rotate(-45)"/>
      <rect x="23.04" y="23.04" width="11.52" height="5.76" rx="1.92" transform="rotate(-45)"/>
      <rect x="34.56" y="-34.56" width="11.52" height="5.76" rx="1.92" transform="rotate(45)"/>
      <rect x="-23.04" y="23.04" width="11.52" height="5.76" rx="1.92" transform="rotate(45)"/>
    </g>
    
    <!-- Center hole -->
    <circle cx="0" cy="0" r="11.52" fill="#007bff"/>
  </g>
  
  <!-- Text -->
  <text x="96" y="163.2" font-family="Arial, sans-serif" font-size="23.04" font-weight="bold" text-anchor="middle" fill="#ffffff">سایدا</text>
</svg>
