
<svg width="128" height="128" viewBox="0 0 128 128" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#007bff;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0056b3;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background Circle -->
  <circle cx="64" cy="64" r="60" fill="url(#bg)" stroke="#ffffff" stroke-width="2"/>
  
  <!-- Gear Icon -->
  <g transform="translate(64, 64)">
    <!-- Main gear body -->
    <circle cx="0" cy="0" r="19.2" fill="#ffffff" opacity="0.9"/>
    
    <!-- Gear teeth -->
    <g fill="#ffffff" opacity="0.8">
      <!-- Top teeth -->
      <rect x="-2.56" y="-32" width="5.12" height="10.24" rx="1.28"/>
      <rect x="-2.56" y="21.76" width="5.12" height="10.24" rx="1.28"/>
      
      <!-- Side teeth -->
      <rect x="-32" y="-2.56" width="10.24" height="5.12" rx="1.28"/>
      <rect x="21.76" y="-2.56" width="10.24" height="5.12" rx="1.28"/>
      
      <!-- Diagonal teeth -->
      <rect x="-23.04" y="-23.04" width="7.68" height="3.84" rx="1.28" transform="rotate(-45)"/>
      <rect x="15.36" y="15.36" width="7.68" height="3.84" rx="1.28" transform="rotate(-45)"/>
      <rect x="23.04" y="-23.04" width="7.68" height="3.84" rx="1.28" transform="rotate(45)"/>
      <rect x="-15.36" y="15.36" width="7.68" height="3.84" rx="1.28" transform="rotate(45)"/>
    </g>
    
    <!-- Center hole -->
    <circle cx="0" cy="0" r="7.68" fill="#007bff"/>
  </g>
  
  <!-- Text -->
  <text x="64" y="108.8" font-family="Arial, sans-serif" font-size="15.36" font-weight="bold" text-anchor="middle" fill="#ffffff">سایدا</text>
</svg>
