# MechCraft Hub Environment Configuration Template
# Copy this file to .env and fill in your actual values
# Never commit the .env file to version control

# =============================================================================
# DJANGO CONFIGURATION
# =============================================================================
SECRET_KEY=your-super-secret-key-here-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Local PostgreSQL (Liara production - runs inside app container on persistent disk)
# Do NOT set DATABASE_URL on Liara; it overrides POSTGRES_* and reconnects to managed DB.
POSTGRES_DB=mechcraft
POSTGRES_USER=mechcraft
POSTGRES_PASSWORD=your-secure-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data
BACKUP_DIR=/app/backups
AUTO_BACKUP=1

# Optional: restore from emergency dump on first boot (path inside container)
# RESTORE_DUMP=/app/backups/emergency.dump

# Optional: auto-create admin on first deploy
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=change-me
# DJANGO_SUPERUSER_EMAIL=admin@example.com

# Legacy managed Liara PostgreSQL (deprecated - remove from Liara env)
# DATABASE_URL=postgresql://root:your-password@sayda-db:5432/postgres

# Local development: SQLite
# USE_SQLITE=1

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_PASSWORD=your-secure-redis-password
REDIS_URL=redis://:your-secure-redis-password@localhost:6379/0

# =============================================================================
# BACKUP / OBJECT STORAGE (Liara bucket or AWS S3)
# =============================================================================
# Set S3_UPLOAD=1 in Liara env to upload daily backups to bucket
S3_UPLOAD=0
S3_BACKUP_PREFIX=postgresql
LIARA_ACCESS_KEY=your-liara-access-key
LIARA_SECRET_KEY=your-liara-secret-key
LIARA_ENDPOINT_URL=https://storage.c2.liara.space
FILE_BUCKET_NAME=your-backup-bucket-name
FILE_REGION=iran

# AWS-compatible fallback for backup_db / pg_backup
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_REGION_NAME=us-east-1
S3_BACKUP_BUCKET=your-backup-bucket-name

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# Email Configuration (Liara SMTP)
EMAIL_HOST=smtp.c1.liara.email
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=your-liara-email-username
EMAIL_HOST_PASSWORD=your-liara-email-password
DEFAULT_FROM_EMAIL=info@example.com

# Liara Email Service (Alternative naming)
MAIL_HOST=smtp.c1.liara.email
MAIL_PORT=465
MAIL_USER=your-liara-email-username
MAIL_PASSWORD=your-liara-email-password
MAIL_FROM_ADDRESS=info@example.com
MAIL_FROM_NAME=MechCraft Hub

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Cloudflare Turnstile (for CAPTCHA)
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
VITE_TURNSTILE_SITEKEY=your-turnstile-site-key

# Google Generative AI (Gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_NAME=gemini-1.5-flash

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
# Sentry (for error tracking)
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=1.0.0
SENTRY_TRACES_SAMPLE_RATE=0.1

# =============================================================================
# GRAFANA CONFIGURATION
# =============================================================================
GRAFANA_PASSWORD=your-grafana-admin-password

# =============================================================================
# FILE UPLOAD SECURITY
# =============================================================================
CLAMAV_ENABLED=True
CLAMAV_SOCKET=/var/run/clamav/clamd.ctl
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=pdf,image,document,cad

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
BACKUP_RETENTION_DAYS=30

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
FRONTEND_URL=http://localhost:8080

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# Set to False in production
DEBUG=True

# Development database (SQLite)
# Uncomment to use SQLite instead of PostgreSQL
# DB_ENGINE=sqlite

# Development email backend (console)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# =============================================================================
# PRODUCTION CONFIGURATION
# =============================================================================
# Uncomment and configure for production deployment

# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SESSION_COOKIE_HTTPONLY=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# SECURE_CONTENT_TYPE_NOSNIFF=True
# SECURE_BROWSER_XSS_FILTER=True
# X_FRAME_OPTIONS=DENY
# SECURE_REFERRER_POLICY=strict-origin-when-cross-origin

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
# Docker Compose environment variables
COMPOSE_PROJECT_NAME=mechcraft
POSTGRES_DB=mechcraft
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-database-password
REDIS_PASSWORD=your-secure-redis-password

# =============================================================================
# CI/CD CONFIGURATION
# =============================================================================
# GitHub Actions secrets (configure in repository settings)
# SECRET_KEY
# POSTGRES_PASSWORD
# REDIS_PASSWORD
# AWS_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY
# S3_BACKUP_BUCKET
# SENTRY_DSN
# TURNSTILE_SITE_KEY
# TURNSTILE_SECRET_KEY
# EMAIL_HOST_PASSWORD
# GRAFANA_PASSWORD
