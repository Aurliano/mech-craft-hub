# Environment Variables Template for MechCraft Hub
# Copy this file to .env and fill in your actual values

# Django Settings
DEBUG=False
SECRET_KEY=your-super-secret-production-key-here-change-this
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,localhost

# Database (PostgreSQL for Production)
DB_ENGINE=django.db.backends.postgresql
POSTGRES_DB=mechcraft_prod
POSTGRES_USER=mechcraft_user
POSTGRES_PASSWORD=your-secure-db-password-here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Cache
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=your-redis-password-here

# ClamAV Antivirus
CLAMAV_SOCKET=/var/run/clamav/clamd.ctl
CLAMAV_ENABLED=True

# Sentry Error Tracking
SENTRY_DSN=https://your-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=1.0.0
SENTRY_TRACES_SAMPLE_RATE=0.1

# AWS S3 for Backups
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_REGION_NAME=us-east-1
S3_BACKUP_BUCKET=mechcraft-backups

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Google Generative AI (Gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_NAME=gemini-1.5-flash

# Frontend URL
FRONTEND_URL=https://yourdomain.com

# Grafana
GRAFANA_PASSWORD=your-grafana-admin-password

# File Upload Limits
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=pdf,image,document,cad