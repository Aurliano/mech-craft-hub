# Liara deployment Dockerfile - Django + local PostgreSQL on persistent disk
#
# registry-1.docker.io is blocked/slow from Iran — use Liara's Docker Hub mirror.
# Docs: https://docs.liara.ir/mirrors/docker/
ARG PYTHON_BASE=docker-mirror.liara.ir/library/python:3.11-slim
FROM ${PYTHON_BASE}

# Liara mirrors for apt/pip (avoid timeouts during build in Iran)
ENV PIP_INDEX_URL=https://package-mirror.liara.ir/repository/pypi/simple
ENV PIP_TRUSTED_HOST=package-mirror.liara.ir

# Configure apt to handle network timeouts better (keep default Debian sources — Liara mirror path breaks on trixie)
RUN echo 'Acquire::http::Timeout "120";' > /etc/apt/apt.conf.d/99timeout && \
    echo 'Acquire::ftp::Timeout "120";' >> /etc/apt/apt.conf.d/99timeout && \
    echo 'Acquire::Retries "5";' >> /etc/apt/apt.conf.d/99timeout

# Install runtime dependencies including PostgreSQL server and client
RUN for i in 1 2 3; do \
        apt-get update --fix-missing && \
        apt-get install -y --no-install-recommends \
            libpq5 \
            curl \
            postgresql \
            postgresql-client \
            procps \
        && rm -rf /var/lib/apt/lists/* \
        && apt-get clean \
        && exit 0; \
        sleep $((i * 10)); \
    done; \
    echo "apt-get install failed after 3 attempts" >&2; exit 1

WORKDIR /app

COPY requirements_liara.txt requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

COPY . .

RUN find . -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true && \
    find . -name "*.pyc" -delete 2>/dev/null || true

RUN mkdir -p /app/backend/media /app/staticfiles /tmp/staticfiles_runtime /app/backups /var/lib/postgresql/data && \
    chmod +x /app/start_liara_with_postgres.sh /app/scripts/emergency_db_recovery.sh /app/scripts/backup_legacy_sayda_db.sh /app/scripts/backup_scheduler.sh /app/backend/scripts/pg_backup.sh /app/backend/scripts/pg_restore.sh

ENV PYTHONUNBUFFERED=1
ENV DJANGO_SETTINGS_MODULE=config.settings_ultra_simple
ENV PYTHONPATH=/app/backend
ENV STATIC_ROOT=/app/staticfiles
ENV PGDATA=/var/lib/postgresql/data
ENV BACKUP_DIR=/app/backups

EXPOSE 80

# collectstatic does not require PostgreSQL at build time
RUN USE_SQLITE=1 python backend/manage.py collectstatic --noinput

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=5 \
  CMD curl -f http://127.0.0.1:80/api/health/ || exit 1

CMD ["/bin/bash", "/app/start_liara_with_postgres.sh"]
