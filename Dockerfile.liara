# Optimized Dockerfile for Liara deployment - No Node.js build
FROM python:3.11-slim

# Install system dependencies (no Node.js needed)
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create app user
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Set working directory
WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy source code (including pre-built frontend)
COPY . .

# Set environment variables (available at build-time for management commands)
ENV PYTHONPATH=/app/backend
ENV PYTHONUNBUFFERED=1
ENV DJANGO_SETTINGS_MODULE=config.settings_ultra_simple
ENV SECRET_KEY=docker-build-secret

# Set up Django directories and collect static files
RUN mkdir -p /app/logs /app/media /app/staticfiles && \
    chown -R appuser:appuser /app && \
    cd /app/backend && \
    python manage.py collectstatic --noinput

# Switch to app user
USER appuser

# Re-assert runtime environment variables (can be overridden by platform)
ENV PYTHONPATH=/app/backend
ENV PYTHONUNBUFFERED=1
ENV DJANGO_SETTINGS_MODULE=config.settings_ultra_simple

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:80/health/ || exit 1

# Expose port
EXPOSE 80

# Make startup script executable
RUN chmod +x /app/start.sh

# Start command
CMD ["/app/start.sh"]