# Optimized Dockerfile for Liara deployment - No Node.js build
FROM python:3.11-slim

# Install system dependencies (no Node.js needed)
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create app user
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Set working directory
WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy source code (including pre-built frontend)
COPY . .

# Set environment variables (available at build-time for management commands)
ENV PYTHONPATH=/app/backend
ENV PYTHONUNBUFFERED=1
ENV DJANGO_SETTINGS_MODULE=config.settings_ultra_simple
ENV SECRET_KEY=docker-build-secret

# Set up Django directories and collect static files
# Create directories for both scientific content and user uploads with proper permissions
RUN mkdir -p /app/logs /app/staticfiles \
    /app/backend/media/scientific-content/books \
    /app/backend/media/scientific-content/documents \
    /app/backend/media/scientific-content/videos \
    /app/backend/media/scientific-content/software \
    /app/backend/media/scientific-content/others \
    /app/backend/media/user-uploads \
    /app/backend/media/deliveries && \
    chown -R appuser:appuser /app && \
    chmod -R 755 /app/backend/media && \
    cd /app/backend && \
    python manage.py collectstatic --noinput --clear

# Remove any conflicting PWA files from staticfiles to avoid conflicts
RUN rm -rf /app/backend/staticfiles/icons /app/backend/staticfiles/screenshots /app/backend/staticfiles/service-worker.js /app/backend/staticfiles/manifest.json /app/backend/staticfiles/web.config /app/backend/staticfiles/pwa-debug.js /app/backend/staticfiles/pwa-test.js /app/backend/staticfiles/mime-test.js || true

# Ensure PWA files are accessible and fix permissions
RUN chmod 644 /app/dist/service-worker.js && \
    chmod 644 /app/dist/manifest.json && \
    chmod 644 /app/dist/web.config && \
    chmod -R 644 /app/dist/icons/ && \
    chmod -R 644 /app/dist/screenshots/ && \
    chown -R appuser:appuser /app/dist/

# Switch to app user
USER appuser

# Re-assert runtime environment variables (can be overridden by platform)
ENV PYTHONPATH=/app/backend
ENV PYTHONUNBUFFERED=1
ENV DJANGO_SETTINGS_MODULE=config.settings_ultra_simple

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:80/health/ || exit 1

# Expose port
EXPOSE 80

# Working directory for runtime
WORKDIR /app/backend

# Start command - Run migrations and start gunicorn
CMD ["sh", "-c", "python manage.py migrate --noinput && python manage.py collectstatic --noinput --clear && rm -rf /app/backend/staticfiles/icons /app/backend/staticfiles/screenshots /app/backend/staticfiles/service-worker.js /app/backend/staticfiles/manifest.json /app/backend/staticfiles/web.config /app/backend/staticfiles/pwa-debug.js /app/backend/staticfiles/pwa-test.js /app/backend/staticfiles/mime-test.js || true && exec gunicorn config.wsgi:application --bind 0.0.0.0:80 --workers 3 --timeout 120 --max-requests 1000 --max-requests-jitter 100 --preload"]