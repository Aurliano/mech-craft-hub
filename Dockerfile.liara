# Liara deployment Dockerfile - Optimized for fast builds
# Using single-stage build since psycopg2-binary doesn't need compilation
FROM python:3.11-slim

# Configure apt to handle network timeouts better
RUN echo 'Acquire::http::Timeout "60";' > /etc/apt/apt.conf.d/99timeout && \
    echo 'Acquire::ftp::Timeout "60";' >> /etc/apt/apt.conf.d/99timeout && \
    echo 'Acquire::Retries "5";' >> /etc/apt/apt.conf.d/99timeout

# Install ONLY runtime dependencies (no build tools needed for psycopg2-binary)
# Retry up to 3 times with exponential backoff
RUN for i in 1 2 3; do \
        apt-get update --fix-missing && \
        apt-get install -y --no-install-recommends \
            libpq5 \
            curl \
        && rm -rf /var/lib/apt/lists/* \
        && apt-get clean \
        && break || sleep $((i * 10)); \
    done

# NOTE: run as root to be able to write to mounted disk
# If you need to drop privileges later, do it after verifying disk permissions

WORKDIR /app

# Copy requirements first for better Docker layer caching
COPY requirements_liara.txt requirements.txt

# Install Python dependencies (psycopg2-binary is pre-compiled, no build tools needed)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Cleanup
RUN find . -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true && \
    find . -name "*.pyc" -delete 2>/dev/null || true

# Ensure media/static directories exist (the disk will be mounted over /app/backend/media)
RUN mkdir -p /app/backend/media /app/staticfiles /tmp/staticfiles_runtime

ENV PYTHONUNBUFFERED=1
ENV DJANGO_SETTINGS_MODULE=config.settings_ultra_simple
ENV PYTHONPATH=/app/backend
ENV STATIC_ROOT=/app/staticfiles

EXPOSE 80

# Collect static files at build time so Django admin assets are present
RUN python backend/manage.py collectstatic --noinput

# Use root path for healthcheck to avoid missing /health endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:80/api/health/ || exit 1

CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:80", "--workers", "3", "--timeout", "120", "--max-requests", "1000", "--max-requests-jitter", "100", "--preload"]